FROM rust:1.83-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock* ./
COPY deskward-core ./deskward-core
COPY deskward-relay ./deskward-relay
RUN cargo build --release -p deskward-relay

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/deskward-relay /usr/local/bin/
ENV DESKWARD_RELAY_ADDR=0.0.0.0:29117
ENTRYPOINT ["deskward-relay"]
